<?xml version="1.0"?>
<ruleset name="EazyDocs Free Coding Standards">
	<description>WordPress Coding Standards configuration for EazyDocs Free.</description>

	<file>eazydocs.php</file>
	<file>blocks.php</file>
	<file>includes</file>
	<file>shortcodes</file>
	<file>templates</file>

	<exclude-pattern>*/includes/csf/*</exclude-pattern>
	<exclude-pattern>*/freemius-sdk/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>

	<arg value="ps"/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>

	<config name="testVersion" value="8.1-"/>
	<config name="minimum_wp_version" value="6.6"/>

	<rule ref="WordPress-Core">
		<exclude name="WordPress.Files.FileName"/>
		<exclude name="Generic.Arrays.DisallowShortArraySyntax"/>
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
	</rule>

	<rule ref="WordPress-Extra"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="eazydocs"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="ezd_"/>
				<element value="EZD_"/>
				<element value="eazydocs"/>
				<element value="eaz_"/>
				<element value="EazyDocs"/>
			</property>
		</properties>
	</rule>
</ruleset>
